{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transpose",
  "version": "0.7.0",
  "identifier": "dev.ryan.TranslateAnywhere",
  "build": {
    "beforeDevCommand": "npm run build && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Transpose",
        "width": 860,
        "height": 720,
        "minWidth": 680,
        "minHeight": 480,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "settings"
      ],
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist-web/": "frontend/",
      "../assets/Localization/en.lproj/": "en.lproj/",
      "../assets/Localization/zh-Hans.lproj/": "zh-Hans.lproj/",
      "../LICENSE": "LICENSE.txt"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEQzU5QzhFOTVFQUZGNkQKUldSdC8rcVZqcHpGRFNtYkVqdHV3c2RaQjFnaTdyUCt4YlFtTDNnd1RyR216NVN6bFJCZzlhUU8K",
      "endpoints": [
        "https://github.com/Ryanhu2001/Transpose/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
